# Copie para .env e troque os valores. NUNCA versione o .env.
NODE_ENV=production
PORT=3000
ADMIN_USER=admin
# Gere com: node scripts/gerar-hash.js "sua-senha-forte"
ADMIN_PASSWORD_HASH=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
IOT_DEVICE_KEY=
# Segredo do pseudônimo LGPD (nome do cidadão -> código) usado no data lake
PSEUDONIMO_SECRET=
# Pasta do data lake (bronze/prata/ouro). "off" desliga a ingestão
DATALAKE_DIR=datalake
